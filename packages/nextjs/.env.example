# === ChambaChain — variables del servidor (NUNCA se exponen al navegador) ===

# API key de Groq (capa gratuita, sin tarjeta). Obtenla en https://console.groq.com/keys
GROQ_API_KEY=

# (Opcional) Sobrescribe el modelo por defecto (llama-3.3-70b-versatile).
# GROQ_MODEL=

# Llave privada del ORACLE: la address que firma `submitAttestation`.
# Debe estar autorizada en el contrato (el deployer lo esta automaticamente,
# porque el constructor lo registra como primer oracle).
#
# En la devnet local usa la llave pre-fondeada del deployer (es publica y de
# prueba, NO la uses en ninguna red real):
#   0xb6b15c8cb491557369f3c7d2c287b053eb229daa9c22138887752191c9520659
#   -> address 0x3f1Eae7D46d88F08fc2F8ed27FCb2AB183EB2d0E
#
# En Arbitrum Sepolia usa una llave propia y fondeada con ETH de testnet.
ORACLE_PRIVATE_KEY=
